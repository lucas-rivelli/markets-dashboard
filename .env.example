# Copy to .env.local for local dev (npm run dev)
# Also add these to Vercel → Settings → Environment Variables for production

# Feed cron security (generate: openssl rand -hex 32)
# Set the same value in Vercel env vars AND GitHub → Settings → Secrets → Actions
CRON_SECRET=

# Spotify — from developer.spotify.com/dashboard
# Redirect URI in app settings: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# From: npm run spotify:auth
SPOTIFY_REFRESH_TOKEN=

# Value Investors Club — do not paste cookies. Cookies expire and datacenter
# IPs (Vercel / GitHub Actions) get a bot check. Refresh from this Mac:
#   VIC_HEADLESS=0 npm run sync:vic     # first run: log in, check Remember me
# Daily: npm run setup:vic-sync  (Mac LaunchAgent — automatic)
# Optional: auto-login in that Chrome profile
VIC_LOGIN=
VIC_PASSWORD=
# Optional overrides
# VIC_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# VIC_CHROME_PROFILE=~/.markets-vic-chrome
# VIC_HEADLESS=0
# Cookie fallback only (fragile — not needed once Chrome profile is logged in)
# VIC_SESSION=
# VIC_REMEMBER=

# Knowledge base saves — GitHub token needs Contents: read/write
GITHUB_TOKEN=
GITHUB_OWNER=lucas-rivelli
GITHUB_REPO=markets-dashboard
GITHUB_BRANCH=main
# Shared secret sent by the frontend as X-Save-Secret or Authorization: Bearer ...
# Required for /api/save and /api/workspace writes when set.
# On each device, run once in the browser console:
#   localStorage.setItem('markets_save_secret', 'YOUR_SECRET')
SAVE_SECRET=
# On each browser/device (once): localStorage.setItem('markets_save_secret', '<SAVE_SECRET>')

# Optional — only if bird can't read browser cookies (launchd/cron)
# AUTH_TOKEN=
# CT0=

# ── Markets Reading: Signals (fmkt256-signals branch only) ──────────────────
# LLM extraction — Anthropic direct (production / GitHub Actions secret)
ANTHROPIC_API_KEY=
# ...or OpenRouter -> Claude (local fallback, same key as the briefing)
# OPENROUTER_API_KEY=
# Optional price fallback (free tier) if Nasdaq/Yahoo throttle datacenter IPs
FMP_API_KEY=
# Public ntfy.sh topic for alerts — anyone can subscribe at ntfy.sh/<topic>,
# so pick a hard-to-guess name. Also set as a GitHub Actions secret.
NTFY_TOPIC=
# Public URL of the signals deployment (used for links inside alerts)
# SIGNALS_PUBLIC_URL=
# Branch the signals Vercel project serves data from (default fmkt256-signals)
# SIGNALS_DATA_BRANCH=fmkt256-signals
# SIGNALS_BRANCH=fmkt256-signals
# Token with Actions:write so POST /api/signals/refresh can dispatch the workflow
# GITHUB_DISPATCH_TOKEN=
