# Copy to .env.local for local dev (npm run dev)
# Also add these to Vercel → Settings → Environment Variables for production

# Feed cron security (generate: openssl rand -hex 32)
# Set the same value in Vercel env vars AND GitHub → Settings → Secrets → Actions
CRON_SECRET=

# Spotify — from developer.spotify.com/dashboard
# Redirect URI in app settings: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# From: npm run spotify:auth
SPOTIFY_REFRESH_TOKEN=

# Knowledge base saves — GitHub token needs Contents: read/write
GITHUB_TOKEN=
GITHUB_OWNER=lucas-rivelli
GITHUB_REPO=markets-dashboard
GITHUB_BRANCH=main
# Shared secret sent by the frontend as X-Save-Secret or Authorization: Bearer ...
SAVE_SECRET=

# Optional — only if bird can't read browser cookies (launchd/cron)
# AUTH_TOKEN=
# CT0=
