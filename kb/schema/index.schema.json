{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb-index.schema.json",
  "title": "Knowledge Base Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "counts", "facets", "items"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inbox", "notes", "items"],
      "properties": {
        "inbox": { "type": "integer" },
        "notes": { "type": "integer" },
        "items": { "type": "integer" }
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "themes",
        "tickers",
        "folders",
        "tags",
        "sources",
        "categories",
        "types",
        "content_kinds",
        "statuses"
      ],
      "properties": {
        "themes": { "$ref": "#/$defs/facet_list" },
        "tickers": { "$ref": "#/$defs/facet_list" },
        "folders": { "$ref": "#/$defs/facet_list" },
        "tags": { "$ref": "#/$defs/facet_list" },
        "sources": { "$ref": "#/$defs/facet_list" },
        "categories": { "$ref": "#/$defs/facet_list" },
        "types": { "$ref": "#/$defs/facet_list" },
        "content_kinds": { "$ref": "#/$defs/facet_list" },
        "statuses": { "$ref": "#/$defs/facet_list" }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "facet_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "count"],
        "properties": {
          "name": { "type": "string" },
          "count": { "type": "integer" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "source",
        "category",
        "type",
        "date",
        "saved_at",
        "status",
        "themes",
        "tickers",
        "folders",
        "tags",
        "summary",
        "snippet",
        "content_kind",
        "highlight_count",
        "content_text",
        "inbox_path",
        "note_path",
        "search_text"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "source": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": ["string", "null"] },
        "saved_at": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["saved", "enriched"] },
        "themes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tickers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "folders": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": { "type": "string" },
        "snippet": { "type": "string" },
        "content_kind": { "type": "string" },
        "highlight_count": { "type": "integer", "minimum": 0 },
        "content_text": { "type": "string" },
        "content_meta": { "type": ["object", "null"] },
        "inbox_path": { "type": ["string", "null"] },
        "note_path": { "type": ["string", "null"] },
        "search_text": { "type": "string" }
      }
    }
  }
}
